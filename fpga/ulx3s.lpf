# SPDX-License-Identifier: MIT
# ULX3S v2.x pin constraints for fpga/ulx3s_top.v (sites from emard/ulx3s
# doc/constraints/ulx3s_v20.lpf).
BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE;
LOCATE COMP "clk_25mhz" SITE "G2"; IOBUF PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;
LOCATE COMP "ftdi_rxd" SITE "L4"; IOBUF PORT "ftdi_rxd" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "ftdi_txd" SITE "M1"; IOBUF PORT "ftdi_txd" PULLMODE=UP IO_TYPE=LVCMOS33;
LOCATE COMP "led[0]" SITE "B2"; LOCATE COMP "led[1]" SITE "C2";
LOCATE COMP "led[2]" SITE "C1"; LOCATE COMP "led[3]" SITE "D2";
LOCATE COMP "led[4]" SITE "D1"; LOCATE COMP "led[5]" SITE "E2";
LOCATE COMP "led[6]" SITE "E1"; LOCATE COMP "led[7]" SITE "H3";
IOBUF PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=4; IOBUF PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=4; IOBUF PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=4; IOBUF PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[6]" IO_TYPE=LVCMOS33 DRIVE=4; IOBUF PORT "led[7]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "btn[0]" SITE "D6"; LOCATE COMP "btn[1]" SITE "R1"; LOCATE COMP "btn[2]" SITE "T1";
LOCATE COMP "btn[3]" SITE "R18"; LOCATE COMP "btn[4]" SITE "V1"; LOCATE COMP "btn[5]" SITE "U1";
LOCATE COMP "btn[6]" SITE "H16";
IOBUF PORT "btn[0]" PULLMODE=UP IO_TYPE=LVCMOS33; IOBUF PORT "btn[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "btn[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33; IOBUF PORT "btn[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "btn[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33; IOBUF PORT "btn[5]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "btn[6]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
# secure element SPI on the GPIO header
LOCATE COMP "se_cs_n" SITE "B11"; IOBUF PORT "se_cs_n" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "se_sck"  SITE "A10"; IOBUF PORT "se_sck"  IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "se_mosi" SITE "A9";  IOBUF PORT "se_mosi" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "se_miso" SITE "B10"; IOBUF PORT "se_miso" PULLMODE=UP IO_TYPE=LVCMOS33;
# tamper mesh: out gp4..7, back in gn4..7
LOCATE COMP "mesh_o[0]" SITE "A7"; LOCATE COMP "mesh_o[1]" SITE "C8";
LOCATE COMP "mesh_o[2]" SITE "C6"; LOCATE COMP "mesh_o[3]" SITE "A6";
LOCATE COMP "mesh_i[0]" SITE "A8"; LOCATE COMP "mesh_i[1]" SITE "B8";
LOCATE COMP "mesh_i[2]" SITE "C7"; LOCATE COMP "mesh_i[3]" SITE "B6";
IOBUF PORT "mesh_o[0]" IO_TYPE=LVCMOS33 DRIVE=4; IOBUF PORT "mesh_o[1]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "mesh_o[2]" IO_TYPE=LVCMOS33 DRIVE=4; IOBUF PORT "mesh_o[3]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "mesh_i[0]" PULLMODE=DOWN IO_TYPE=LVCMOS33; IOBUF PORT "mesh_i[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "mesh_i[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33; IOBUF PORT "mesh_i[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
LOCATE COMP "noise_in" SITE "A4"; IOBUF PORT "noise_in" PULLMODE=DOWN IO_TYPE=LVCMOS33;
